{
  "$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",
  "root": false,
  "extends": "//",
  "linter": {
    "rules": {
      "correctness": {
        // Server code runs on Bun and uses Node built-ins.
        "noNodejsModules": "off"
      },
      "nursery": {
        // These builders keep inferred return types. The Elysia instances are
        // route contracts, AgentApiServices is derived from the Layer that
        // agentApiLayer returns, and the Eden client type follows the API's App.
        "useExplicitReturnType": {
          "level": "error",
          "options": {
            "allowedNames": [
              "agentApiLayer",
              "createApp",
              "createHealthModule",
              "createTaskSummaryModule",
              "createTasksApiClient"
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/**", "!src/index.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "Bun": "This code also runs on Node under Vitest. Use Node APIs, and read env only in entry points."
                }
              }
            }
          }
        }
      }
    },
    {
      // The Bun entry point is the one place that reads the environment or
      // loads Bun modules; it passes typed config down.
      "includes": ["src/index.ts"],
      "linter": {
        "rules": {
          "nursery": { "noBunModules": "off" },
          "style": { "noProcessEnv": "off" }
        }
      }
    }
  ]
}
