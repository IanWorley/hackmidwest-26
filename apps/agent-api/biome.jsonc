{
  "$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",
  "root": false,
  "extends": "//",
  "linter": {
    "rules": {
      "correctness": {
        // Server code runs on Bun and uses Node built-ins.
        "noNodejsModules": "off"
      },
      "nursery": {
        // These builders keep inferred return types. The Elysia instances are
        // route contracts, AgentApiServices is derived from the Layer that
        // agentApiLayer returns, and step and stepSchema carry each run step's
        // tool literal into the run log's type.
        "useExplicitReturnType": {
          "level": "error",
          "options": {
            "allowedNames": [
              "agentApiLayer",
              "createApp",
              "createHealthModule",
              "createNarrateModule",
              "createOrchestrateModule",
              "createTaskSummaryModule",
              "step",
              "stepSchema"
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      // Effect service keys and tagged errors are classes. runtime.ts is the
      // one place every service key is declared and provided, and
      // api-client.ts declares the errors its ports fail with.
      "includes": ["src/runtime.ts", "src/api-client.ts"],
      "linter": {
        "rules": {
          "style": { "noExcessiveClassesPerFile": "off" }
        }
      }
    },
    {
      // Features reach apps/api only through the narrow ports in runtime.ts, so
      // none can call a route the ports leave out, such as decisions or dispatch.
      // Override options replace the root's, so `patterns` repeats the root
      // list verbatim; test/module-boundaries.test.ts fails if it drifts.
      "includes": ["src/features/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../**/*/src/**", "!../**/../src/**"],
                    "message": "Import another workspace through its package name, not a relative path into its source."
                  },
                  {
                    "group": ["**/packages/*", "**/packages/*/**"],
                    "message": "Import a shared package through its package exports, never from its folder."
                  },
                  {
                    "group": ["@/**/../**"],
                    "message": "The @/ alias reaches only the web app's src; import other workspaces through their package names."
                  },
                  {
                    "group": ["**/node_modules/**"],
                    "message": "Import packages by name, never through a node_modules path."
                  }
                ],
                "paths": {
                  "@elysiajs/eden": "Yield ClosureApi or TasksApi from ../runtime. Only src/api-client.ts holds the Eden client.",
                  "@hackmidwest/api/contract": "Yield ClosureApi or TasksApi from ../runtime. Only src/api-client.ts holds the Eden client."
                }
              }
            }
          }
        }
      }
    },
    {
      // t3env keys its schemas by environment variable name, which is CONSTANT_CASE.
      "includes": ["src/config.ts"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": {
              "level": "error",
              "options": {
                "conventions": [
                  {
                    "selector": { "kind": "objectLiteralProperty" },
                    "formats": ["camelCase", "CONSTANT_CASE"]
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/**", "!src/index.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "Bun": "This code also runs on Node under Vitest. Use Node APIs, and read env only in entry points."
                }
              }
            }
          }
        }
      }
    },
    {
      // The Bun entry point is the one place that reads the environment or
      // loads Bun modules; it passes typed config down.
      "includes": ["src/index.ts"],
      "linter": {
        "rules": {
          "nursery": { "noBunModules": "off" },
          "style": { "noProcessEnv": "off" }
        }
      }
    }
  ]
}
