{
  "$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",
  "root": false,
  "extends": "//",
  "css": { "parser": { "tailwindDirectives": true } },
  "overrides": [
    {
      // The production server is a Bun entry point outside the browser
      // bundle: it reads the environment, uses Node and Bun modules, and keys
      // its t3env schema by the CONSTANT_CASE variable name.
      "includes": ["serve.ts"],
      "linter": {
        "rules": {
          "correctness": { "noNodejsModules": "off" },
          "nursery": { "noBunModules": "off" },
          "style": {
            "noProcessEnv": "off",
            "useNamingConvention": {
              "level": "error",
              "options": {
                "conventions": [
                  {
                    "selector": { "kind": "objectLiteralProperty" },
                    "formats": ["camelCase", "CONSTANT_CASE"]
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // t3env keys its schemas by environment variable name, which is CONSTANT_CASE.
      "includes": ["src/config.ts"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": {
              "level": "error",
              "options": {
                "conventions": [
                  {
                    "selector": { "kind": "objectLiteralProperty" },
                    "formats": ["camelCase", "CONSTANT_CASE"]
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // Label tables are keyed by posture, action, reason, and directive
      // names, which are snake_case domain values from the API contract.
      "includes": [
        "src/features/closure/labels.ts",
        "src/features/closure/notification-labels.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": {
              "level": "error",
              "options": {
                "conventions": [
                  {
                    "selector": { "kind": "objectLiteralProperty" },
                    "formats": ["camelCase", "snake_case"]
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // Vendored shadcn/ui CLI output, regenerated by `shadcn add`; edits made
      // to pass these rules would be lost on the next add. The formatter still runs.
      "includes": ["src/components/ui/**"],
      "linter": {
        "rules": {
          "nursery": {
            "noTailwindArbitraryValue": "off",
            "noUnsafeTypeAssertion": "off",
            "useExplicitReturnType": "off",
            "useSortedClasses": "off",
            "useStrictBooleanExpressions": "off",
            "useTailwindShorthandClasses": "off"
          },
          "performance": { "noNamespaceImport": "off" },
          "security": { "noSecrets": "off" },
          "style": {
            "noImplicitBoolean": "off",
            "noJsxLiterals": "off",
            "noTernary": "off",
            "useComponentExportOnlyModules": "off",
            "useImportType": "off"
          },
          "suspicious": { "noLeakedRender": "off" }
        }
      }
    },
    {
      // Biome resolves `styles.css?url` to the stylesheet, which has no
      // exports. Vite's client types give the URL import a string default,
      // and tsc checks it.
      "includes": ["src/routes/__root.tsx"],
      "linter": {
        "rules": { "correctness": { "noUnresolvedImports": "off" } }
      }
    },
    {
      // Tailwind's entry imports declare their own cascade layers and must stay
      // top level, and Biome does not see properties declared in `@theme`.
      "includes": ["src/styles.css"],
      "linter": {
        "rules": {
          "nursery": {
            "noUndeclaredCustomProperties": "off",
            "useLayeredStyles": "off"
          }
        }
      }
    },
    {
      // The build-time plugin list shared by vite.config.ts and
      // vitest.config.ts; its imports are build tools.
      "includes": ["react-plugins.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredDependencies": {
              "level": "error",
              "options": { "devDependencies": true }
            }
          }
        }
      }
    }
  ],
  "linter": {
    "rules": {
      "style": {
        "noRestrictedGlobals": {
          "level": "error",
          "options": {
            "deniedGlobals": {
              "fetch": "Call application endpoints through the Eden client."
            }
          }
        },
        // Add bans with `paths`; a `patterns` list here would replace the
        // root's. Server packages are already undeclared dependencies here.
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "@hackmidwest/api": "Import types from @hackmidwest/api/contract."
            }
          }
        }
      },
      "nursery": {
        // Tailwind generates utility classes at build time, so no stylesheet
        // declares them.
        "noUndeclaredClasses": "off",
        // TanStack registers the router and loader data by their inferred types.
        "useExplicitReturnType": {
          "level": "error",
          "options": {
            "allowedNames": [
              "getRouter",
              "loadBuildings",
              "loadDecisionScreen",
              "loadDirectives",
              "loadFacilities",
              "loadFacility",
              "loadFacilityDate",
              "loadHistory",
              "loadLatestRecommendation",
              "loadRecorders",
              "loadTasks"
            ]
          }
        }
      }
    }
  }
}
