{
  "name": "@hackmidwest/api",
  "private": true,
  "type": "module",
  "exports": {
    "./contract": {
      "types": "./src/contract.ts"
    }
  },
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/index.ts",
    "start": "bun --env-file=../../.env dist/index.js",
    "typecheck": "tsc --project tsconfig.json",
    "build": "bun build src/index.ts --target=bun --packages=external --outdir dist",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "bun --env-file=../../.env scripts/migrate.ts",
    "db:seed": "bun --env-file=../../.env scripts/seed.ts"
  },
  "dependencies": {
    "elysia": "1.4.30",
    "@elysiajs/cors": "1.4.2",
    "@libsql/client": "0.18.0",
    "drizzle-orm": "0.45.4",
    "drizzle-typebox": "0.3.3",
    "@sinclair/typebox": "0.34.52"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "drizzle-kit": "0.31.11"
  }
}
