{
  "name": "@hackmidwest/api",
  "private": true,
  "type": "module",
  "exports": {
    "./contract": {
      "types": "./src/contract.ts"
    }
  },
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/index.ts",
    "start": "bun --env-file=../../.env dist/index.js",
    "typecheck": "tsc --project tsconfig.json",
    "build": "bun build src/index.ts --target=bun --packages=external --outdir dist"
  },
  "dependencies": {
    "@hackmidwest/db": "workspace:*",
    "@elysiajs/cors": "1.4.2",
    "@sinclair/typebox": "0.34.52",
    "drizzle-orm": "0.45.4",
    "drizzle-typebox": "0.3.3",
    "effect": "4.0.2",
    "elysia": "1.4.30"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "vitest": "5.0.3"
  }
}
