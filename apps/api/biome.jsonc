{
  "$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",
  "root": false,
  "extends": "//",
  "linter": {
    "rules": {
      "correctness": {
        // Server code runs on Bun and uses Node built-ins.
        "noNodejsModules": "off"
      },
      "nursery": {
        // These builders keep inferred return types. The Elysia instance
        // type is the API contract the web app consumes, and ApiServices is
        // derived from the Layer that apiLayer returns.
        "useExplicitReturnType": {
          "level": "error",
          "options": {
            "allowedNames": ["apiLayer", "createApp", "createTasksModule"]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/**", "!src/index.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "Bun": "This code also runs on Node under Vitest. Use Node APIs, and read env only in entry points."
                }
              }
            }
          }
        }
      }
    },
    {
      // Effect service keys are classes, and runtime.ts is the one place
      // every service key is declared and provided.
      "includes": ["src/runtime.ts"],
      "linter": {
        "rules": {
          "style": { "noExcessiveClassesPerFile": "off" }
        }
      }
    },
    {
      // The Bun entry point is the one place that reads the environment or
      // loads Bun modules; it passes typed config down.
      "includes": ["src/index.ts"],
      "linter": {
        "rules": {
          "nursery": { "noBunModules": "off" },
          "style": { "noProcessEnv": "off" }
        }
      }
    }
  ]
}
