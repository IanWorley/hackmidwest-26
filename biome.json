{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!**/routeTree.gen.ts", "!**/dist", "!**/.data"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error"
      },
      "style": {
        "useImportType": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "overrides": [
    {
      "includes": ["apps/**", "!apps/api/src/index.ts", "!apps/api/scripts/**"],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "error"
          }
        }
      }
    },
    {
      "includes": [
        "apps/api/src/**",
        "apps/api/test/**",
        "!apps/api/src/index.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "Bun": "API modules also run under Vitest on Node. Use Node APIs, and read env only in src/index.ts."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@hackmidwest/api": "Import types from @hackmidwest/api/contract."
                },
                "patterns": [
                  {
                    "group": ["**/api/src/**"],
                    "message": "The web app may import only the API type-only package export."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
