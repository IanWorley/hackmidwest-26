{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!**/routeTree.gen.ts", "!**/dist", "!**/.data"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error"
      },
      "style": {
        "useImportType": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "overrides": [
    {
      "includes": [
        "apps/**",
        "packages/**",
        "!apps/*/src/index.ts",
        "!packages/db/scripts/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "error"
          }
        }
      }
    },
    {
      "includes": [
        "apps/*/src/**",
        "packages/db/src/**",
        "!apps/web/**",
        "!apps/*/src/index.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "Bun": "This code also runs under Vitest on Node. Use Node APIs, and read env only in entry points."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/**", "!apps/web/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/packages/db", "**/packages/db/**"],
                    "message": "Import from @hackmidwest/db, @hackmidwest/db/connection, or @hackmidwest/db/testing, never from its source files."
                  },
                  {
                    "group": ["**/src/**"],
                    "message": "Never import another app's source, not even its types. Use its package export, such as @hackmidwest/api/contract."
                  },
                  {
                    "group": ["**/node_modules/**"],
                    "message": "Import packages by name, never through a node_modules path."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@hackmidwest/api": "Import types from @hackmidwest/api/contract."
                },
                "patterns": [
                  {
                    "group": ["**/*api/src/**"],
                    "message": "The web app may import only the API type-only package export, never any backend's source."
                  },
                  {
                    "group": [
                      "@hackmidwest/db",
                      "@hackmidwest/db/**",
                      "**/packages/db",
                      "**/packages/db/**"
                    ],
                    "message": "The web app reaches data only through the API."
                  },
                  {
                    "group": ["**/node_modules/**"],
                    "message": "Import packages by name, never through a node_modules path."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
