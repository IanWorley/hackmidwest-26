{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!**/routeTree.gen.ts", "!**/dist", "!**/.data"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error"
      },
      "style": {
        "useImportType": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "overrides": [
    {
      "includes": ["apps/web/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@hackmidwest/api": "Import types from @hackmidwest/api/contract.",
                  "@hackmidwest/db": "The web app reaches data only through the API.",
                  "@hackmidwest/db/testing": "The web app reaches data only through the API."
                },
                "patterns": [
                  {
                    "group": ["**/api/src/**"],
                    "message": "The web app may import only the API type-only package export."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
