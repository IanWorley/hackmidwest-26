{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!**/routeTree.gen.ts", "!**/dist", "!**/.data"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error"
      },
      "style": {
        "useImportType": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "overrides": [
    {
      "includes": [
        "apps/**",
        "packages/**",
        "!apps/api/src/index.ts",
        "!packages/db/scripts/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "error"
          }
        }
      }
    },
    {
      "includes": [
        "apps/api/src/**",
        "packages/db/src/**",
        "!apps/api/src/index.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "Bun": "This code also runs under Vitest on Node. Use Node APIs, and read env only in entry points."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/api/src/**", "!apps/api/src/index.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@hackmidwest/db": {
                    "importNames": ["openDatabase", "*"],
                    "message": "Only src/index.ts opens the database. Accept `db: Database` as a parameter."
                  }
                },
                "patterns": [
                  {
                    "group": ["**/packages/db/**"],
                    "message": "Import from @hackmidwest/db or @hackmidwest/db/testing, never from its source files."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@hackmidwest/api": "Import types from @hackmidwest/api/contract.",
                  "@hackmidwest/db": "The web app reaches data only through the API.",
                  "@hackmidwest/db/testing": "The web app reaches data only through the API."
                },
                "patterns": [
                  {
                    "group": ["**/api/src/**"],
                    "message": "The web app may import only the API type-only package export."
                  },
                  {
                    "group": ["**/packages/db/**"],
                    "message": "The web app reaches data only through the API."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
