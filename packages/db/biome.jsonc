{
  "$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",
  "root": false,
  "extends": "//",
  "linter": {
    "rules": {
      "correctness": {
        // Persistence runs on Bun and Node and needs their file APIs.
        "noNodejsModules": "off"
      },
      "nursery": {
        // The connection's type is inferred from Drizzle; Database derives from it.
        "useExplicitReturnType": {
          "level": "error",
          "options": { "allowedNames": ["openDatabase"] }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "Bun": "This code also runs on Node under Vitest. Use Node APIs, and read env only in entry points."
                }
              }
            }
          }
        }
      }
    },
    {
      // The package entry points and the schema index re-export their modules;
      // drizzle-kit and the client read every table through the schema index.
      "includes": ["src/index.ts", "src/schema/index.ts", "src/testing.ts"],
      "linter": {
        "rules": {
          "performance": { "noBarrelFile": "off" }
        }
      }
    },
    {
      // Drizzle needs every table; the namespace import keeps the schema index
      // the only list of them.
      "includes": ["src/client.ts"],
      "linter": {
        "rules": {
          "performance": { "noNamespaceImport": "off" }
        }
      }
    },
    {
      // Drizzle marks only primaryKey's positional overload deprecated; the
      // object form the schema uses is current, but the rule flags the import.
      "includes": ["src/schema/facilities.ts"],
      "linter": {
        "rules": {
          "suspicious": { "noDeprecatedImports": "off" }
        }
      }
    },
    {
      // Operator CLI scripts read the environment once at startup.
      "includes": ["scripts/**"],
      "linter": {
        "rules": {
          "style": { "noProcessEnv": "off" }
        }
      }
    }
  ]
}
