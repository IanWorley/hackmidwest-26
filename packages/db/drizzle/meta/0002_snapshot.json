        "decisions_chosen_posture": {
          "name": "decisions_chosen_posture",
          "value": "(\"decisions\".\"chosen_posture\" is not null) = (\"decisions\".\"action\" in ('accept', 'override')) and (\"decisions\".\"chosen_posture\" is null or \"decisions\".\"chosen_posture\" in ('normal', 'delayed_arrival', 'early_dismissal', 'unscheduled_telework', 'full_closure'))"
