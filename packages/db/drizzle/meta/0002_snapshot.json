          "value": "typeof(\"decisions\".\"minutes_before_decide_by\") = 'integer'"
        },
        "decisions_identity_verified_boolean": {
          "name": "decisions_identity_verified_boolean",
          "value": "\"decisions\".\"identity_verified\" in (0, 1)"
        },
        "decisions_reason_pair": {
          "name": "decisions_reason_pair",
          "value": "(\"decisions\".\"reason_category\" is null) = (\"decisions\".\"reason_text\" is null) and (\"decisions\".\"reason_category\" is null or \"decisions\".\"reason_category\" in ('local_conditions', 'road_reports', 'directive', 'essential_operations', 'data_looks_wrong', 'other') and trim(\"decisions\".\"reason_text\", char(32, 9, 10, 11, 12, 13)) <> '')"
        },
        "decisions_override_and_defer_require_reason": {
          "name": "decisions_override_and_defer_require_reason",
          "value": "not (\"decisions\".\"action\" in ('override', 'defer')) or \"decisions\".\"reason_category\" is not null"
        },
        "decisions_supersede_requires_reason": {
          "name": "decisions_supersede_requires_reason",
          "value": "not (\"decisions\".\"supersedes_decision_id\" is not null) or \"decisions\".\"reason_category\" is not null"
        },
        "decisions_content_hash_sha256": {
