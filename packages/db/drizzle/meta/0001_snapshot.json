          "value": "\"employees\".\"telework_eligible\" in (0, 1)"
        },
        "employees_sms_requires_mobile_phone": {
          "name": "employees_sms_requires_mobile_phone",
          "value": "not (\"employees\".\"preferred_channel\" = 'sms') or \"employees\".\"mobile_phone\" is not null and trim(\"employees\".\"mobile_phone\") <> ''"
        },
        "employees_shift": {
          "name": "employees_shift",
          "value": "(\"employees\".\"shift_start\" is null) = (\"employees\".\"shift_end\" is null) and \"employees\".\"shift_start\" is strftime('%H:%M', \"employees\".\"shift_start\") and \"employees\".\"shift_start\" < '24:00' and \"employees\".\"shift_end\" is strftime('%H:%M', \"employees\".\"shift_end\") and \"employees\".\"shift_end\" < '24:00' and \"employees\".\"shift_start\" < \"employees\".\"shift_end\""
        },
