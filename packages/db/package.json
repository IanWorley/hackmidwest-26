{
  "name": "@hackmidwest/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./connection": "./src/client.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "bun --env-file=../../.env scripts/migrate.ts",
    "db:seed": "bun --env-file=../../.env scripts/seed.ts"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "drizzle-orm": "0.45.4"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11",
    "vitest": "5.0.3"
  }
}
