{
  "$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",
  "root": false,
  "extends": "//",
  "linter": {
    "rules": {
      "correctness": {
        // Server code runs on Bun and uses Node built-ins.
        "noNodejsModules": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/**", "!src/index.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "Bun": "This code also runs on Node under Vitest. Use Node APIs, and read env only in entry points."
                }
              }
            }
          }
        }
      }
    },
    {
      // The Bun entry point is the one place that reads the environment or
      // loads Bun modules; it passes typed config down.
      "includes": ["src/index.ts"],
      "linter": {
        "rules": {
          "nursery": { "noBunModules": "off" },
          "style": { "noProcessEnv": "off" }
        }
      }
    }
  ]
}
