# Bun loads this root file through the API scripts; Vite uses root envDir.
# API_PORT is the listener port. The public URL may have a different port behind a proxy.
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
# The agent API listener port.
AGENT_API_PORT=3002
# The agent API's Anthropic SDK reads ANTHROPIC_API_KEY (or an `ant auth login` profile).
# ANTHROPIC_API_KEY=
# Relative paths resolve against the repository root, independent of command cwd.
DB_PATH=.data/development.sqlite
# Public and compiled into the web build. Never put secrets in VITE_* variables.
VITE_API_BASE_URL=http://localhost:3001
